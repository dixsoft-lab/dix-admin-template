{
	"name": "dix-admin-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.19.0",
		"npm": ">=10.8.0"
	},
	"scripts": {
		"dev": "vite",
		"preview": "vite preview",
		"lint": "eslint src",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"build": "npm run typecheck && vite build",
		"verify:template-layout": "node scripts/verify-template-layout.mjs",
		"remove:demo": "node scripts/remove-demo.mjs",
		"verify:template-contracts": "node scripts/verify-template-contracts.mjs",
		"verify:design-system-modes": "node scripts/verify-design-system-modes.mjs",
		"verify:consumer-modes": "node scripts/verify-consumer-modes.mjs",
		"verify:consumer-docs": "node scripts/verify-consumer-docs.mjs",
		"verify:agent-docs": "node scripts/verify-agent-docs.mjs",
		"verify:agent-kit-install": "node scripts/verify-agent-kit-install.mjs",
		"verify:skills": "node scripts/verify-template-skills.mjs",
		"verify:template-domain-boundary": "node scripts/verify-template-domain-boundary.mjs",
		"verify:template-architecture": "node scripts/verify-template-architecture.mjs",
		"verify:template-routes": "node scripts/verify-template-routes.mjs"
	},
	"dependencies": {
		"react": "19.1.1",
		"react-dom": "19.1.1",
		"react-router-dom": "7.18.3"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/react": "16.3.0",
		"@types/node": "24.3.0",
		"@types/react": "19.1.10",
		"@types/react-dom": "19.1.7",
		"@typescript-eslint/parser": "8.72.1",
		"@vitejs/plugin-react": "5.0.2",
		"eslint": "10.13.0",
		"eslint-plugin-better-tailwindcss": "4.10.0",
		"jsdom": "26.1.0",
		"prettier": "^3.9.6",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.2",
		"vite": "7.3.7",
		"vitest": "4.1.12"
	}
}
